{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunnelminion.local/schemas/interview-showcase-failure-fixtures-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_set", "scenarios"],
  "properties": {
    "$schema": {"const": "failure-scenarios.schema.json"},
    "schema_version": {"const": 1},
    "fixture_set": {"const": "interview-showcase-offline-failures"},
    "scenarios": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "category",
        "fixture",
        "display_label",
        "input",
        "expected"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "model-unavailable",
            "node-offline",
            "tool-timeout",
            "duplicate-event",
            "out-of-order-event",
            "conflicting-evidence",
            "operation-unapproved",
            "execution-failed",
            "recovery-failed"
          ]
        },
        "fixture": {"const": true},
        "display_label": {"const": "离线 fixture，不是真实 A/B 运行"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "events"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_status",
            "safety_action",
            "include_in_final_metrics",
            "include_in_success_media",
            "counts_as_real_ab"
          ],
          "properties": {
            "public_status": {"type": "string", "minLength": 1},
            "safety_action": {"type": "string", "minLength": 1},
            "include_in_final_metrics": {"const": false},
            "include_in_success_media": {"const": false},
            "counts_as_real_ab": {"const": false}
          }
        }
      }
    }
  }
}
