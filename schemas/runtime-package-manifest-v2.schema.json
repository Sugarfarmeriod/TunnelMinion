{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunnelminion.local/schemas/runtime-package-manifest-v2.schema.json",
  "title": "TunnelMinion Runtime Package Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "build",
    "frontend",
    "entrypoint",
    "entrypoint_args",
    "files",
    "licenses"
  ],
  "properties": {
    "schema_version": { "const": "runtime-package-manifest/v2" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layout",
        "platform",
        "architecture",
        "python_version",
        "application_version"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
        "layout": { "const": "onedir-freeze" },
        "platform": { "enum": ["win32", "darwin"] },
        "architecture": { "enum": ["amd64", "arm64"] },
        "python_version": { "type": "string", "pattern": "^3\\.(11|12|13)\\.[0-9]+$" },
        "application_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9._-]+)?$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "source_tree_sha256",
        "python_lock_sha256",
        "npm_lock_sha256",
        "builder"
      ],
      "properties": {
        "source_revision": { "$ref": "#/$defs/sha256OrRevision" },
        "source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "python_lock_sha256": { "$ref": "#/$defs/sha256" },
        "npm_lock_sha256": { "$ref": "#/$defs/sha256" },
        "builder": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "sha256", "file_count"],
      "properties": {
        "root": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 1 }
      }
    },
    "entrypoint": { "$ref": "#/$defs/relativePath" },
    "entrypoint_args": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "type"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0 },
          "type": {
            "enum": ["runtime", "entrypoint", "frontend", "schema", "license-evidence"]
          }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecosystem", "name", "version", "license", "source"],
        "properties": {
          "ecosystem": { "enum": ["python", "npm"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "type": "string", "minLength": 1, "maxLength": 80 },
          "license": { "type": "string", "minLength": 1, "maxLength": 240 },
          "source": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256OrRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    }
  }
}
