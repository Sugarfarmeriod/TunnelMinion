{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunnelminion.local/schemas/runtime-package-manifest-v1.schema.json",
  "title": "TunnelMinion Runtime Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "build",
    "entrypoint",
    "entrypoint_args",
    "files",
    "licenses"
  ],
  "properties": {
    "schema_version": {
      "const": "runtime-package-manifest/v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layout",
        "platform",
        "architecture",
        "python_version",
        "application_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "layout": {
          "enum": [
            "onedir-freeze",
            "standalone-cpython-wheel"
          ]
        },
        "platform": {
          "enum": [
            "win32",
            "darwin"
          ]
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "python_version": {
          "type": "string",
          "pattern": "^3\\.(11|12|13)\\.[0-9]+$"
        },
        "application_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9._-]+)?$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "source_tree_sha256",
        "lock_sha256",
        "builder"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "builder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "entrypoint": {
      "$ref": "#/$defs/relativePath"
    },
    "entrypoint_args": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "license"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    }
  }
}
